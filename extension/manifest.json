{
  "manifest_version": 2,
  "name": "Local Browser Bridge (dev)",
  "version": "1.5.1",
  "description": "Lets Claude Code control your own Firefox through a local bridge on 127.0.0.1.",
  "browser_specific_settings": {
    "gecko": {
      "id": "claude-in-firefox@local.bridge",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "tabs",
    "storage",
    "tabGroups",
    "webRequest",
    "<all_urls>",
    "http://127.0.0.1/*"
  ],
  "background": {
    "scripts": [
      "config.js",
      "background.js"
    ],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "browser_action": {
    "default_title": "Local Browser Bridge (dev)",
    "default_icon": "icon.svg"
  },
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "options_ui": {
    "page": "options.html",
    "browser_style": false
  }
}